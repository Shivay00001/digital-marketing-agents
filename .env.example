# Set your preferred provider: gpt4free, openai, groq
LLM_PROVIDER=gpt4free

# --- For gpt4free (Default) ---
# Ensure you are running the g4f api server locally (e.g., `g4f api`)
G4F_BASE_URL=http://127.0.0.1:1337/v1

# --- For OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here

# --- For Groq (Free high-speed alternative) ---
GROQ_API_KEY=your_groq_api_key_here

# --- SEO Tools ---
SERPAPI_API_KEY=your_serpapi_key_here
